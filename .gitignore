# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev server logs
.next-dev*.log
.codex-next-*.log

# Historical source workbooks are local inputs and may contain business data.
/data/*.xls
/data/*.xlsx

.vercel
.env*

# Generated staging SQL copies and local Supabase runtime; recreate via script.
/staging/supabase/migrations/
/staging/supabase/.temp/
/staging/supabase/.branches/

# Private local runtime configuration, keys and credentials.
/staging/runtime/

# Local staging Python validation artifacts.
/scripts/__pycache__/
/tests/__pycache__/

# Supabase CLI metadata is local, never part of a backup.
/supabase/.temp/

# Private checkout validation evidence: generated local identifiers and logs.
/reports/checkout-guest-local-diagnosis-20261012.md
/reports/reservation-expiry-local-*.json
/reports/reservation-expiry-local-validation-20261012.md
/reports/transfer-rules-local-*.json
/reports/transfer-rules-local-validation-20261012.md
/reports/transfer-rules-*-tests-20261012.log
/reports/transfer-rules-real-local-*.json

# Private executor preparation report; publish only the aggregated PR review.
/reports/checkout-expiration-executor-local-20261012.md
