# Local staging ONLY. Obtain local keys from supabase status --workdir staging.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_LOCAL_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_LOCAL_SERVICE_ROLE_KEY
ADMIN_ALLOWED_EMAILS=admin@staging.invalid
# Enable only in this isolated runtime after verifying Auth/CAPTCHA configuration.
CHECKOUT_GUEST_ENABLED=true
NEXT_PUBLIC_CHECKOUT_TURNSTILE_SITE_KEY=REPLACE_WITH_STAGING_ONLY_SITE_KEY
